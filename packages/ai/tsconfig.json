{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**/*", "dist", "node_modules"]
}
