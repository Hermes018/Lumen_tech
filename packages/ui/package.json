{
  "name": "@lumen/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/tokens.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "tsc --incremental",
    "lint": "eslint src",
    "test": "vitest run --pool=forks --maxWorkers=2 --no-file-parallelism",
    "typecheck": "tsc --noEmit --incremental"
  },
  "dependencies": {
    "@lumen/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "postcss": "^8.5.32",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
